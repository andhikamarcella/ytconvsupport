{
  "manifest_version": 3,
  "name": "YTConv Support Ticket Processor",
  "description": "Convert user complaint emails into structured tickets and auto-generate professional replies.",
  "version": "1.0.0",
  "permissions": ["storage", "clipboardWrite"],
  "host_permissions": ["https://api.telegram.org/*"],
  "action": {
    "default_title": "YTConv Support Ticket Processor",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.svg",
    "48": "icons/icon48.svg",
    "128": "icons/icon128.svg"
  }
}

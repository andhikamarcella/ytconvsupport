{
  "manifest_version": 3,
  "name": "YTConv Support System Ultimate",
  "description": "Mini helpdesk system for parsing complaint emails, managing tickets, SLA tracking, replies, and analytics.",
  "version": "2.0.0",
  "permissions": ["storage", "clipboardWrite"],
  "host_permissions": ["https://api.telegram.org/*"],
  "action": {
    "default_title": "YTConv Support System Ultimate",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.svg",
    "48": "icons/icon48.svg",
    "128": "icons/icon128.svg"
  }
}

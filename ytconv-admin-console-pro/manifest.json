{
  "manifest_version": 3,
  "name": "YTConv Admin Console PRO",
  "description": "Advanced admin support tool for managing reports, tickets, AI responses, exports, and Telegram integration.",
  "version": "1.0.0",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://api.telegram.org/*"
  ],
  "action": {
    "default_title": "YTConv Admin Console PRO",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.svg",
    "48": "icons/icon48.svg",
    "128": "icons/icon128.svg"
  }
}